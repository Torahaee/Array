1> Write a C++ program to input and display elements of an array.
#include<iostream>
using namespace std;

int main(){
    int arr[5];
    for(int i=0; i<=4; i++){
        cin>>arr[i];
        cout<<arr[i]<<" ";
    }
}

2> Write a C++ program to find the sum of elements of an array.
#include<iostream>
using namespace std;

int main(){
    int arr[5]={2,3,1,0,6};
    int sum=0;
    for(int i=0; i<=4; i++){
        sum=sum+arr[i];
    }
    cout<<sum;
}

