1> Bubble Sort
#include<iostream>
using namespace std;

int main(){
    int arr[5]={5,4,3,2,1};
    int n=5;
    for(int i=0; i<n; i++){
        for(int j=0; j<=n-2; j++){
            if(arr[j] > arr[j+1]){
                swap(arr[j],arr[j+1]);
            }
        }
    }
    //display the array
    for(int i=0; i<n; i++){
        cout<<arr[i]<<" ";
    }
}

2> Insertion sorting
#include<iostream>
using namespace std;

//Insertion Sorting
int main(){
    int arr[5]={5,4,3,2,1};
    int n=5;
    for(int i=1; i<n; i++){
        for(int j=i; j>0; j--){
            if(arr[j] < arr[j-1]){
                swap(arr[j],arr[j-1]);
            }
        }
    }
    //display the array
    for(int i=0; i<n; i++){
        cout<<arr[i]<<" ";
    }
}

